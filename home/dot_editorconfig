# EditorConfig is awesome: https://EditorConfig.org
# ~/.editorconfig will be treated as global in some editors
# neovim should pick it up automatically if it's in home directory
root = true

[*]
charset = utf-8
insert_final_newline = true
#end_of_line = lf
#trim_trailing_whitespace = true

# Default indentation for all files
indent_style = space
indent_size = 4
tab_width = 4

[*.sh]
indent_style = space
indent_size = 4
tab_width = 4

[*.c]
indent_style = space
indent_size = 4
tab_width = 4

[*.h]
indent_style = tab
indent_size = 4
tab_width = 4

[*.lua]
indent_style = space
indent_size = 2
tab_width = 2

[*.py]
indent_style = space
indent_size = 4
tab_width = 4

